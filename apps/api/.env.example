# Copia este archivo a .env y completa los valores.

# URL de PostgreSQL. Si se omite, en local se usa PGlite en ./.pglite
# (PostgreSQL embebido, sin instalar nada).
DATABASE_URL=

# Secreto de Better Auth. Genera uno con:
#   openssl rand -base64 32
AUTH_SECRET=cambia-este-secreto-generado-aleatoriamente

# Puerto del servidor local.
PORT=3001

# Orígenes permitidos para CORS (separados por coma).
CORS_ORIGIN=http://localhost:5173

# Acceso con Google (opcional). Sin estas variables NO se muestra el
# botón en el login. No las dejes con valores a medias: mejor vacías.
# Guía completa: docs/google-signin.md
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# URL pública de la app: Better Auth construye con ella el callback
# (https://<app>/api/auth/callback/google). En local, el dev server.
BETTER_AUTH_URL=http://localhost:5173

# Correo transaccional (Resend). Sin esta clave se omite el envío con
# un aviso; las invitaciones siguen funcionando desde la interfaz.
RESEND_API_KEY=
# Remitente verificado en Resend, por ejemplo: Mantivecinos <no-reply@tudominio.com>
EMAIL_FROM=
