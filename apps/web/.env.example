# Normalmente NO hace falta configurar nada:
# - En local, Vite hace proxy de /api a http://localhost:3001.
# - En producción, vercel.json reenvía /api al proyecto de la API.
# Solo define esta variable si quieres apuntar a otra instancia de la API.
VITE_API_URL=

# Contacto de privacidad que aparece en los avisos legales (/legal).
# En producción se define en Vercel; si está vacía, la página omite el correo.
VITE_LEGAL_CONTACT_EMAIL=
